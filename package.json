{
  "name": "skele",
  "version": "0.1.0",
  "description": "A calm, local-first workspace for notes, tasks, projects and databases.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/flatten-prefetch.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:desktop": "node tests/desktop/windows-e2e.mjs",
    "legacy:db": "node tools/legacy-db.mjs start",
    "legacy:export": "node tools/legacy-export.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:icons": "tauri icon src-tauri/app-icon.png",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tiptap/extension-code-block-lowlight": "^3.33.1",
    "@tiptap/extension-details": "^3.33.1",
    "@tiptap/extension-drag-handle-react": "^3.33.1",
    "@tiptap/extension-file-handler": "^3.33.1",
    "@tiptap/extension-highlight": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-list": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-text-style": "^3.33.1",
    "@tiptap/extensions": "^3.33.1",
    "@tiptap/markdown": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@tiptap/suggestion": "^3.33.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "d3-force": "^3.0.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "fractional-indexing": "^4.0.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.22.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "embedded-postgres": "^17.11.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.8",
    "pg": "^8.23.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.11.0-beta.19": true,
    "esbuild@0.28.2": true
  }
}
