# Skele runs entirely in the browser / desktop app and needs no environment variables.
# Everything below is optional. NEXT_PUBLIC_* values are baked in at build time.

# Default Spotify Client ID for builds you distribute (users can override it in
# Settings → Integrations). This is a public identifier, not a secret — Skele uses PKCE.
# NEXT_PUBLIC_SPOTIFY_CLIENT_ID=""

# Built-in Gmail client for desktop builds, so users connect Gmail in one click (Connect →
# sign in with Google in the browser). A Google Cloud OAuth client of type "Desktop app"; Google
# treats a Desktop client's secret as public. Users can still use their own client instead.
# See docs/GMAIL.md. Browser copies of Skele ignore these and need the user's own client.
# NEXT_PUBLIC_GMAIL_CLIENT_ID=""
# NEXT_PUBLIC_GMAIL_CLIENT_SECRET=""

# Maximum attachment size in MB (default 50).
# NEXT_PUBLIC_MAX_UPLOAD_MB="50"

# Only for migrating data from the old server-based Skele (see docs/MIGRATION.md):
# DATABASE_URL="postgresql://skele:skele@localhost:54329/skele"
